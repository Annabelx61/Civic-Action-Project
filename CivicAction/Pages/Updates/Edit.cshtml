@page
@model CivicAction.Pages.Updates.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Update</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Update.Id" />
            <div class="form-group">
<span class="text-danger">*</span>
                <label asp-for="Update.Description" class="control-label"></label>
                <input asp-for="Update.Description" class="form-control" aria-required="true"/>
                <span asp-validation-for="Update.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
<span class="text-danger">*</span>
                <label asp-for="Update.Date" class="control-label"></label>
                <input asp-for="Update.Date" class="form-control" aria-required="true"/>
                <span asp-validation-for="Update.Date" class="text-danger"></span>
            </div>
            <div class="form-group">
<span class="text-danger">*</span>
                <label asp-for="Update.StartTime" class="control-label"></label>
                <input asp-for="Update.StartTime" class="form-control" aria-required="true"/>
                <span asp-validation-for="Update.StartTime" class="text-danger"></span>
            </div>
            <div class="form-group">
<span class="text-danger">*</span>
                <label asp-for="Update.EndTime" class="control-label"></label>
                <input asp-for="Update.EndTime" class="form-control" aria-required="true"/>
                <span asp-validation-for="Update.EndTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Update.HoursDone" class="control-label"></label>
                <input asp-for="Update.HoursDone" class="form-control" />
                <span asp-validation-for="Update.HoursDone" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Update.VerificationId" class="control-label"></label>
                <select asp-for="Update.VerificationId" class="form-control" asp-items="ViewBag.VerificationId" ></select>
                <span asp-validation-for="Update.VerificationId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
