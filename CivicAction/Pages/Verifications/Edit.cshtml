@page
@model CivicAction.Pages.Verifications.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Verification</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Verification.Id" />
            <div class="form-group">
                <label asp-for="Verification.IsApproved" class="control-label"></label>
                <input asp-for="Verification.IsApproved" class="form-control" />
                <span asp-validation-for="Verification.IsApproved" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Verification.Feedback" class="control-label"></label>
                <input asp-for="Verification.Feedback" class="form-control" />
                <span asp-validation-for="Verification.Feedback" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Verification.AdminId" class="control-label"></label>
                <select asp-for="Verification.AdminId" class="form-control" asp-items="ViewBag.AdminId" ></select>
                <span asp-validation-for="Verification.AdminId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Verification.ProjectId" class="control-label"></label>
                <select asp-for="Verification.ProjectId" class="form-control" asp-items="ViewBag.ProjectId" ></select>
                <span asp-validation-for="Verification.ProjectId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Verification.StudentId" class="control-label"></label>
                <select asp-for="Verification.StudentId" class="form-control" asp-items="ViewBag.StudentId" ></select>
                <span asp-validation-for="Verification.StudentId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
